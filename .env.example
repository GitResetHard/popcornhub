NODE_ENV=development

APP_NAME=Moviestrackr
APP_URL=http://localhost:3000

# Secret used to sign session and OAuth-state cookies. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=

# PostgreSQL connection string. On Vercel use the Neon integration, which sets this for you;
# prefer the pooled ("-pooler") host and keep `?sslmode=require`. Example:
#   postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://moviestrackr:secret@127.0.0.1:5432/moviestrackr_next
DATABASE_POOL_SIZE=10

# Optional. Without Redis the cache falls back to an in-process map.
REDIS_URL=redis://127.0.0.1:6379

# TMDB v4 read access token. https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Optional Google OAuth sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

SESSION_LIFETIME_DAYS=30
SESSION_COOKIE_NAME=moviestrackr_session

# Public base URL where uploaded avatars and clips are served from.
UPLOADS_URL=
